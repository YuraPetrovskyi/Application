# Database
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=event_management
DATABASE_URL="postgresql://your-postgres-user:your-postgres-password@postgres:5432/event_management"

# JWT
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="7d"

# AI (Groq) — get your key at https://console.groq.com
GROQ_API_KEY="your-groq-api-key-here"

# App
PORT=3000

# Frontend URL — used by the backend for CORS (which origins are allowed)
FRONTEND_URL="http://localhost:5173"

# Frontend (Vite)
VITE_API_URL="http://localhost:3000"
