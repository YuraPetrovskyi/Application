# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=event_management
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/event_management"

# JWT
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="7d"

# App
PORT=3000

# Frontend URL — used by the backend for CORS (which origins are allowed)
FRONTEND_URL="http://localhost:5173"

# Frontend (Vite)
VITE_API_URL="http://localhost:3000"
